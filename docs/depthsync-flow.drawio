  <diagram id="v5-detail" name="03 V5 局部场准备">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="V5 拍后准备：锚帧局部 affine 拟合 → 双向光流可信传播 → 低分辨率参数包" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="baseLane" value="A. 稳定基础与光流可靠性" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="2050" height="230" as="geometry"/></mxCell>
        <mxCell id="v4" value="完整执行 V4&#xa;得到 B_0…B_89&#xa;V5 只学习其有限局部增量" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="baseLane"><mxGeometry x="70" y="65" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="rgb" value="RGB 90 帧&#xa;缩放至 144×256" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="baseLane"><mxGeometry x="410" y="75" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="raft" value="SEA-RAFT-S&#xa;89 对 × 正反两个方向&#xa;可合并双向 batch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="baseLane"><mxGeometry x="710" y="60" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="fb" value="连续 flow confidence&#xa;模型置信度 × FB consistency&#xa;× in-bounds × 亮度/梯度一致性" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="baseLane"><mxGeometry x="1060" y="55" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="cut" value="切镜检测&#xa;32×18 luminance robust diff&#xa;cut 边界两向 confidence=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="baseLane"><mxGeometry x="1460" y="60" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="flowdata" value="DenseFlowSequence&#xa;to_next / to_previous：[89,144,256,2]&#xa;confidence_*：[89,144,256]&#xa;scene_cuts：[89]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="baseLane"><mxGeometry x="1830" y="45" width="190" height="150" as="geometry"/></mxCell>

        <mxCell id="fitLane" value="B. 锚帧 k 的 36×64 局部 affine 拟合" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="2050" height="300" as="geometry"/></mxCell>
        <mxCell id="pair" value="拟合数据对&#xa;source = B_k&#xa;target = 对齐并降采样的 P_k&#xa;photo_range = P90 − P10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="fitLane"><mxGeometry x="70" y="80" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="windows" value="每个网格节点&#xa;中心覆盖约 2.5×网格间距的重叠窗口&#xa;有效像素至少 24&#xa;重叠用于消除块边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="fitLane"><mxGeometry x="410" y="70" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="irls" value="两轮 robust IRLS&#xa;Tukey 权重（MAD 尺度）&#xa;+ scale / offset ridge prior&#xa;min Σw|aB+b−P|² + λa|a−1|² + λb|b|²" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="fitLane"><mxGeometry x="790" y="60" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="bounds" value="Box 约束 + 交替重优化&#xa;a ∈ [0.5,1.5]&#xa;b/photo_range ∈ [−0.35,0.35]&#xa;序列存 Δa=a−1 与 b_norm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="fitLane"><mxGeometry x="1230" y="65" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="conf" value="节点拟合置信度 c_k&#xa;support × residual_score × condition_score&#xa;支持不足：Δa=0，b=0，c=0（identity）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="fitLane"><mxGeometry x="1590" y="65" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="smooth" value="锚帧仅一次&#xa;confidence 加权&#xa;3×3 平滑&#xa;传播后不再重平滑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="fitLane"><mxGeometry x="1900" y="75" width="120" height="140" as="geometry"/></mxCell>

        <mxCell id="propLane" value="C. 参数沿真实运动轨迹纯传输（从 k 向两侧扫描）" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="2050" height="300" as="geometry"/></mxCell>
        <mxCell id="resize" value="flow / confidence&#xa;缩放至 36×64 网格&#xa;位移同步缩放到网格单位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="propLane"><mxGeometry x="70" y="85" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="remap" value="current→previous remap&#xa;warp q_prev 与 c_prev&#xa;q=[Δa,b_norm]&#xa;border 常量为 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="propLane"><mxGeometry x="400" y="75" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="vis" value="smoothstep visibility&#xa;u=clamp((r−0.05)/(0.25−0.05))&#xa;visibility=u²(3−2u)&#xa;c_t=warp(c_prev)×visibility" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="propLane"><mxGeometry x="760" y="65" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="active" value="c_t &gt; eps？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="propLane"><mxGeometry x="1170" y="85" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="keep" value="是：保持 warped q&#xa;可信轨迹不再加正则&#xa;避免参数场“呼吸”" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="propLane"><mxGeometry x="1430" y="55" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="zero" value="否 / 切镜 / 遮挡 / 越界&#xa;q=0，c=0&#xa;新显露区域回到 V4 identity&#xa;不继承最近有效参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="propLane"><mxGeometry x="1430" y="175" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="seq" value="输出 LocalFieldSequence&#xa;Δscale / offset_norm / confidence / depth_low&#xa;shape=[90,36,64]，内部 FP32&#xa;持久化前三通道 FP16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="propLane"><mxGeometry x="1830" y="65" width="190" height="170" as="geometry"/></mxCell>

        <mxCell id="note" value="设计禁区（防止历史缺陷复现）：不传播照片深度/残差；不传播人物 mask；不在每帧重新拟合或重新空间正则；不让高 confidence 在长序列中无条件累乘衰减。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="1030" width="1800" height="90" as="geometry"/></mxCell>

