        <mxCell id="b18" edge="1" parent="1" source="keep" target="seq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b19" edge="1" parent="1" source="zero" target="seq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="runtime" name="04 播放与数据规格">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="V4 / V5 播放内核与中间数据规格" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="play" value="A. 每帧播放流程" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="2050" height="330" as="geometry"/></mxCell>
        <mxCell id="d" value="视频模型深度 D_t&#xa;[Hv,Wv] FP16/定点" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="play"><mxGeometry x="60" y="90" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="lut" value="V4 LUT 内核&#xa;16 节点定位 + 线性插值&#xa;+ 帧级 scale/offset&#xa;输出稳定基础 B_t" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="play"><mxGeometry x="350" y="70" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="field" value="读取 t 帧参数&#xa;Δa_t / b_norm_t / c_t&#xa;每通道 36×64 FP16&#xa;当前帧合计 13,824 B" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="play"><mxGeometry x="720" y="65" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="fast" value="max(c_t) &gt; 0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="play"><mxGeometry x="1080" y="80" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="gather" value="深度引导 2×2 gather&#xa;spatial bilinear × exp(−|B_t−B_low|/σd)&#xa;σd = 0.04 × V4 guide robust range&#xa;注意：不使用 DAv2 原始 photo range 作为边缘阈值" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="play"><mxGeometry x="1340" y="55" width="390" height="160" as="geometry"/></mxCell>
        <mxCell id="blend" value="归一化局部参数与 confidence&#xa;correction = Δa·B_t + b_norm·photo_range&#xa;Y_t = B_t + c·correction&#xa;再裁剪到 a∈[0.5,1.5]、b_norm∈[−0.35,0.35]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="play"><mxGeometry x="1810" y="45" width="210" height="180" as="geometry"/></mxCell>
        <mxCell id="identity" value="否：identity 快路径&#xa;直接复制 B_t&#xa;与 V4 逐位一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="play"><mxGeometry x="1080" y="225" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="out" value="同步深度 Y_t" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="play"><mxGeometry x="1810" y="245" width="210" height="60" as="geometry"/></mxCell>

        <mxCell id="spec" value="B. 数据规格与生命周期（90 帧示例）" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="2050" height="420" as="geometry"/></mxCell>
        <mxCell id="s1" value="RGB 视频&#xa;90×256×455×3 uint8&#xa;输入 / 验证原型&#xa;flow 前 resize→144×256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="spec"><mxGeometry x="60" y="65" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="s2" value="视频 disparity&#xa;90×256×455 FP32（原型）&#xa;输入 + 播放&#xa;产品可 FP16 / 定点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="spec"><mxGeometry x="340" y="65" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="s3" value="照片 disparity&#xa;示例 1080×1920 FP32&#xa;仅准备阶段&#xa;配准后降至视频坐标" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="spec"><mxGeometry x="620" y="65" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="s4" value="双向 flow&#xa;2×89×144×256×2 FP16 缓存&#xa;confidence：2×89×144×256 FP16&#xa;只准备阶段，可流式边算边消费" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="spec"><mxGeometry x="900" y="55" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="s5" value="V4 播放包&#xa;共享 LUT x/y：16×2 FP16 = 64 B&#xa;逐帧 scale/offset：90×2 FP16 = 360 B&#xa;+ header / range / flags ≈ 64–128 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="spec"><mxGeometry x="1220" y="50" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="s6" value="V5 播放包&#xa;Δscale：90×36×64 FP16&#xa;offset_norm：同上；confidence：同上&#xa;总计 1,244,160 B ≈ 1.19 MiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="spec"><mxGeometry x="1580" y="50" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="s7" value="depth_low&#xa;90×36×64 FP16&#xa;Python 诊断缓存&#xa;产品从当前 B_t 降采样，不下发" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="spec"><mxGeometry x="1920" y="55" width="100" height="140" as="geometry"/></mxCell>
        <mxCell id="offlineCost" value="准备阶段主耗时&#xa;178 次方向推理（89 对×双向）&#xa;局部 IRLS / remap / FP16 序列化远小于光流&#xa;目标 NPU/GPU 必须实测 1–2 s wall time、峰值内存与热状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="spec"><mxGeometry x="120" y="245" width="570" height="120" as="geometry"/></mxCell>
        <mxCell id="runtimeCost" value="播放阶段主操作&#xa;V4 LUT + 4 邻点 gather + 4 次深度权重 + 归一化 + confidence blend&#xa;exp 可替换为小 LUT / fast-exp / GPU texture；CPU 可 C++/NEON 向量化&#xa;NumPy 原型约 17–18 ms/帧，仅作功能参考" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="spec"><mxGeometry x="810" y="235" width="650" height="140" as="geometry"/></mxCell>
        <mxCell id="opt" value="进一步端侧优化选项（需重新验证边缘）&#xa;1) INT8/INT16 量化局部场；2) flow 流式计算避免整段缓存；&#xa;3) 双向 batch / 帧对并行；4) 将深度权重离散为少量 bin；&#xa;5) 若播放预算严格，在准备阶段烘焙到更高网格。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="spec"><mxGeometry x="1580" y="225" width="440" height="160" as="geometry"/></mxCell>

        <mxCell id="legend" value="颜色图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="910" width="1600" height="180" as="geometry"/></mxCell>
        <mxCell id="l1" value="输入/基础处理" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend"><mxGeometry x="40" y="50" width="250" height="40" as="geometry"/></mxCell>
        <mxCell id="l2" value="V4 全局路径" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend"><mxGeometry x="350" y="50" width="250" height="40" as="geometry"/></mxCell>
        <mxCell id="l3" value="V5 局部路径" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="legend"><mxGeometry x="660" y="50" width="250" height="40" as="geometry"/></mxCell>
        <mxCell id="l4" value="成功输出/轻量播放" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend"><mxGeometry x="970" y="50" width="250" height="40" as="geometry"/></mxCell>
        <mxCell id="l5" value="决策/约束" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="legend"><mxGeometry x="1280" y="50" width="250" height="40" as="geometry"/></mxCell>
        <mxCell id="l6" value="异常/回退" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend"><mxGeometry x="350" y="110" width="250" height="40" as="geometry"/></mxCell>
        <mxCell id="l7" value="中间量/不下发" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="legend"><mxGeometry x="970" y="110" width="250" height="40" as="geometry"/></mxCell>

        <mxCell id="c1" edge="1" parent="1" source="d" target="lut" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2" edge="1" parent="1" source="lut" target="fast" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3" edge="1" parent="1" source="field" target="fast" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c4" value="是" edge="1" parent="1" source="fast" target="gather" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c5" edge="1" parent="1" source="gather" target="blend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c6" value="否" edge="1" parent="1" source="fast" target="identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c7" edge="1" parent="1" source="blend" target="out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c8" edge="1" parent="1" source="identity" target="out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="fallback-validation" name="05 回退与验证闭环">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="V4 / V5 健壮性、验收门槛与版本决策" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="fallback" value="A. 分层回退决策" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="2050" height="430" as="geometry"/></mxCell>
        <mxCell id="start" value="准备 V5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="fallback"><mxGeometry x="70" y="90" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="flowok" value="模型/权重、RGB、flow shape、&#xa;T−1 长度、NaN 检查均有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="300" y="70" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="wholev4" value="整段 V4&#xa;local_fields=None&#xa;记录 v5_flow_unavailable /&#xa;v5_invalid_local_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="fallback"><mxGeometry x="310" y="250" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="cut" value="相邻帧是切镜？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="650" y="75" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="zerocut" value="切镜边界两向 c=0&#xa;禁止跨边界传播&#xa;边界另一侧回退 V4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="640" y="250" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="corr" value="当前网格对应是否&#xa;越界 / 遮挡 / FB 不一致 / 低外观一致？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="940" y="65" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="fade" value="连续降低 visibility 与 c&#xa;不做二值硬 mask&#xa;c→0 时平滑回到 identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="960" y="250" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="support" value="锚帧局部窗口&#xa;有效样本 ≥24 且条件数可接受？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="1320" y="65" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="nodeid" value="节点 identity&#xa;Δa=0，b=0，c=0&#xa;不插值出无依据校正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="1330" y="250" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="serial" value="参数反序列化 / bounds / finite 检查有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="fallback"><mxGeometry x="1630" y="65" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="disable" value="禁用 V5&#xa;使用 V4 参数包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="fallback"><mxGeometry x="1670" y="250" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="ok" value="输出 V5&#xa;c=0 像素&#xa;逐位等于 V4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="fallback"><mxGeometry x="1900" y="85" width="120" height="100" as="geometry"/></mxCell>

        <mxCell id="validate" value="B. 离线验证闭环（不等同于端侧性能结论）" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="550" width="2050" height="500" as="geometry"/></mxCell>
        <mxCell id="dataset" value="测试集&#xa;20 组人像 / 运动 / 遮挡 / 复杂背景&#xa;每组只取 3 s、30 fps、90 帧&#xa;锚帧 k=45；离线单帧锚点为 DAv2-Large" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="validate"><mxGeometry x="70" y="70" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="run" value="固定流水线&#xa;clip → VDA-S stream → DAv2-Large anchor&#xa;→ SEA-RAFT-S → V4/V5 → 指标 → 可视化&#xa;固定模型版本、权重 hash、配置与随机种子" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="validate"><mxGeometry x="480" y="65" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="metrics" value="数值指标（运动补偿后）&#xa;锚帧全图 / 主体 NMAE：V4→V5&#xa;全图 / 主体 temporal P95&#xa;最大新增跳变、平坦区修正梯度 P99&#xa;fallback 数与 Python apply ms/帧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="validate"><mxGeometry x="940" y="55" width="360" height="180" as="geometry"/></mxCell>
        <mxCell id="visual" value="固定值域可视化&#xa;四栏视频：VDA raw | V4 | V5(DAv2) | DAv2 anchor&#xa;同一 P02–P98 显示范围，不逐帧拉伸&#xa;重点检查人物边缘、墙面分层、拖影、尾帧与跳变邻帧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="validate"><mxGeometry x="1380" y="50" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="gate" value="效果与时序门槛同时通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="validate"><mxGeometry x="1880" y="80" width="140" height="130" as="geometry"/></mxCell>
        <mxCell id="pass" value="通过：进入目标 SoC 实测&#xa;1–2 s 准备时延 / 峰值内存 / 功耗 / 热稳态&#xa;再决定默认启用 V5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="validate"><mxGeometry x="1460" y="300" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="fail" value="失败：默认交付 V4&#xa;按场景定位：锚帧拟合 / flow confidence / 上采样边缘阈值 / 量化&#xa;只修改对应模块，保留 V4 基线与可回退版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="validate"><mxGeometry x="940" y="295" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="limits" value="解释边界&#xa;当前没有真实深度 GT；NMAE 衡量与照片锚点的相对一致性，不能宣称绝对深度精度。&#xa;桌面 CPU 光流耗时不能代表目标手机 SoC；端侧可行性必须以编译后模型和真实系统调度实测。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="validate"><mxGeometry x="70" y="285" width="710" height="140" as="geometry"/></mxCell>

