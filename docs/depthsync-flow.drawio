<mxfile host="Electron" agent="Codex" version="24.7.17">
  <diagram id="depthsync-v4-global" name="DepthSync V4 全局 LUT 流程">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DepthSync V4：自适应全局单调 LUT" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="无空间区域标签｜无照片残差传播｜无人物分割 mask｜播放阶段无 MV" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="62" width="1000" height="28" as="geometry"/></mxCell>

        <mxCell id="inputLane" value="A. 输入与统一工作域" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#E8F0FE;strokeColor=#5B8FF9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="1420" height="165" as="geometry"/></mxCell>
        <mxCell id="video" value="视频 disparity&#xa;T×Hv×Wv，FP16/FP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="45" y="55" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="photo" value="照片 disparity&#xa;高质量锚帧 k&#xa;仅参数准备使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="340" y="55" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="mv" value="block MV + confidence&#xa;仅约束逐帧全局参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="645" y="55" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="face" value="可选人脸框&#xa;采样与候选评分加权&#xa;不是分割 mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="950" y="55" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="unify" value="几何配准 + disparity 统一&#xa;照片 P10–P90 鲁棒范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="inputLane"><mxGeometry x="1255" y="50" width="135" height="90" as="geometry"/></mxCell>

        <mxCell id="anchorLane" value="B. 锚帧映射选择" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#EAF7EA;strokeColor=#82B366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1420" height="220" as="geometry"/></mxCell>
        <mxCell id="sample" value="低梯度确定性采样&#xa;分位数 + MAD&#xa;鲁棒 affine 回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="anchorLane"><mxGeometry x="45" y="70" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="candidates" value="并行候选单调 LUT&#xa;8 / 12 / 16 个有效节点&#xa;分箱中位数 + isotonic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="anchorLane"><mxGeometry x="355" y="65" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="score" value="锚帧候选评分&#xa;全图 NMAE + 人脸 ROI NMAE&#xa;选择最低误差形状" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="anchorLane"><mxGeometry x="705" y="65" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="canonical" value="重采样为定长 16 节点&#xa;整段固定非线性形状" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="anchorLane"><mxGeometry x="1055" y="70" width="300" height="105" as="geometry"/></mxCell>

        <mxCell id="temporalLane" value="C. 从锚点双向准备逐帧参数" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E6;strokeColor=#D6B656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1420" height="180" as="geometry"/></mxCell>
        <mxCell id="premap" value="固定 LUT(Di)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="temporalLane"><mxGeometry x="70" y="65" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="correspond" value="block MV 稀疏相邻对应&#xa;confidence 门控" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="temporalLane"><mxGeometry x="355" y="60" width="270" height="85" as="geometry"/></mxCell>
        <mxCell id="fit" value="每帧仅拟合小 scale + offset&#xa;置信度平滑 + 逐帧限幅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="temporalLane"><mxGeometry x="690" y="55" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="lock" value="锚点附近锁定&#xa;向两侧渐进解锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="temporalLane"><mxGeometry x="1065" y="60" width="270" height="85" as="geometry"/></mxCell>

        <mxCell id="runtimeLane" value="D. 端侧播放路径" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1420" height="180" as="geometry"/></mxCell>
        <mxCell id="runtimeInput" value="视频深度 Di" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="runtimeLane"><mxGeometry x="70" y="65" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="runtimeLut" value="16 节点 LUT&#xa;一次线性插值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="runtimeLane"><mxGeometry x="340" y="60" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="runtimeAffine" value="逐帧 scalei / offseti" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="runtimeLane"><mxGeometry x="650" y="65" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="runtimeOutput" value="同步深度 Yi&#xa;全图同一映射，无空间接缝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="runtimeLane"><mxGeometry x="970" y="55" width="330" height="95" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="sample" target="candidates" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="candidates" target="score" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="score" target="canonical" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="premap" target="correspond" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="correspond" target="fit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="fit" target="lock" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="runtimeInput" target="runtimeLut" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="runtimeLut" target="runtimeAffine" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="runtimeAffine" target="runtimeOutput" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
