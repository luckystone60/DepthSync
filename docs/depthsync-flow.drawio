<mxfile host="Electron" agent="Codex">
  <diagram id="depthsync-v3" name="DepthSync V3 处理流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DepthSync V3：单调 LUT + 低分辨率残差网格" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="input-lane" value="输入与统一工作域" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#E8F0FE;strokeColor=#5B8FF9;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="video" value="视频 disparity 序列&#xa;低分辨率、时域一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="input-lane">
          <mxGeometry x="40" y="60" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="photo" value="DepthPro 照片深度&#xa;高分辨率锚帧 k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" vertex="1" parent="input-lane">
          <mxGeometry x="330" y="60" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="mv" value="编码器 / ISP block MV&#xa;低分辨率网格与置信度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="input-lane">
          <mxGeometry x="620" y="60" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="align" value="照片粗配准并降采样&#xa;统一到 disparity 工作域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="input-lane">
          <mxGeometry x="980" y="55" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sample" value="低梯度固定采样&#xa;人脸约 30% / 其余约 70%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" vertex="1" parent="input-lane">
          <mxGeometry x="1300" y="55" width="230" height="85" as="geometry" />
        </mxCell>

        <mxCell id="anchor-lane" value="锚帧映射与照片残差" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#EAF7EA;strokeColor=#82B366;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1570" height="210" as="geometry" />
        </mxCell>
        <mxCell id="affine" value="鲁棒 affine 初始化 / 回退&#xa;分位数 + MAD + 加权最小二乘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;" vertex="1" parent="anchor-lane">
          <mxGeometry x="50" y="70" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lut" value="8 节点单调分段 LUT&#xa;鲁棒分箱中位数 + 单调回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="anchor-lane">
          <mxGeometry x="405" y="70" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="base" value="锚帧基础深度&#xa;B[k] = LUT[k](Dvideo[k])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="anchor-lane">
          <mxGeometry x="750" y="70" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="residual" value="照片空间残差&#xa;R[k] = Dphoto - B[k]&#xa;裁剪、平滑、压缩为 16×9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="anchor-lane">
          <mxGeometry x="1065" y="60" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="anchor-param" value="锚帧紧凑参数&#xa;LUT[k] + grid[k]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;fontStyle=1;" vertex="1" parent="anchor-lane">
          <mxGeometry x="1420" y="70" width="120" height="90" as="geometry" />
        </mxCell>

        <mxCell id="temporal-lane" value="双向时域传播（从 k 向前 / 向后）" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F3ECF7;strokeColor=#9673A6;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1570" height="250" as="geometry" />
        </mxCell>
        <mxCell id="correspond" value="block MV 建立稀疏对应&#xa;无 MV 时使用同位置采样" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="temporal-lane">
          <mxGeometry x="45" y="85" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="frame-lut" value="固定锚帧 LUT 形状&#xa;逐帧只做小幅 affine 修正&#xa;锚点附近渐进解锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="temporal-lane">
          <mxGeometry x="380" y="75" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="grid-warp" value="16×9 残差网格 warp&#xa;低强度复用 block MV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="temporal-lane">
          <mxGeometry x="750" y="85" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="decay" value="锚点距离权重&#xa;±30 帧内余弦衰减&#xa;范围外 residual = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;fontStyle=1;" vertex="1" parent="temporal-lane">
          <mxGeometry x="1080" y="75" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="table" value="逐帧参数表&#xa;8+8 个 LUT 值&#xa;16×9 residual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;fontStyle=1;" vertex="1" parent="temporal-lane">
          <mxGeometry x="1400" y="75" width="135" height="105" as="geometry" />
        </mxCell>

        <mxCell id="output-lane" value="播放阶段与验证输出" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1570" height="210" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="每帧应用&#xa;D' = LUT(D) + upsample(grid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="output-lane">
          <mxGeometry x="130" y="70" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sync-depth" value="V3 同步深度视频&#xa;统一值域、局部偏差更小&#xa;保留视频时域结构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="output-lane">
          <mxGeometry x="620" y="65" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="统一照片值域四联对比&#xa;VDA raw / V1 affine / V3 / DepthPro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="output-lane">
          <mxGeometry x="1100" y="65" width="350" height="105" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="video" target="align" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="photo" target="align" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="align" target="sample" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="sample" target="affine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="affine" target="lut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="lut" target="base" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="base" target="residual" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="residual" target="anchor-param" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="anchor-param" target="frame-lut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673A6;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="mv" target="correspond" value="MV" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D6B656;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="correspond" target="frame-lut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="frame-lut" target="grid-warp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" edge="1" parent="1" source="grid-warp" target="decay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" edge="1" parent="1" source="decay" target="table" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" edge="1" parent="1" source="table" target="runtime" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673A6;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" edge="1" parent="1" source="runtime" target="sync-depth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" edge="1" parent="1" source="sync-depth" target="compare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
