  <diagram id="v4-detail" name="02 V4 全局单调对齐">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="V4：全局单调 LUT + 受约束帧级微调（默认无空间区域边界）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1600" height="40" as="geometry"/></mxCell>
        <mxCell id="io" value="A. 输入与预处理" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="2050" height="190" as="geometry"/></mxCell>
        <mxCell id="d" value="D_t：[T,Hv,Wv]&#xa;FP16/FP32&#xa;disparity 越大越近" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="io"><mxGeometry x="70" y="50" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="p" value="P_k：[Hp,Wp]&#xa;高质量照片 disparity&#xa;仅准备阶段使用" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="io"><mxGeometry x="370" y="50" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="work" value="_to_working&#xa;metric depth → 1/max(depth,eps)&#xa;统一到 disparity 域" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="io"><mxGeometry x="700" y="50" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="align" value="_align_photo&#xa;标定 grid / resize&#xa;对齐至锚帧深度坐标 [Hv,Wv]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="io"><mxGeometry x="1060" y="50" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="sample" value="确定性稀疏采样（默认 2048）&#xa;有限值 + 低梯度优先&#xa;有 face_box 时约 30% 样本来自 ROI&#xa;face_box 不是人物分割 mask" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="io"><mxGeometry x="1450" y="40" width="390" height="115" as="geometry"/></mxCell>
        <mxCell id="mv" value="可选 block MV&#xa;归一化位移 + confidence&#xa;只用于准备阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="io"><mxGeometry x="1900" y="50" width="120" height="95" as="geometry"/></mxCell>

        <mxCell id="anchorLane" value="B. 锚帧全局映射拟合" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="2050" height="270" as="geometry"/></mxCell>
        <mxCell id="robust" value="鲁棒清洗&#xa;分位数 / MAD&#xa;robust affine 拒绝 gross mismatch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="anchorLane"><mxGeometry x="70" y="75" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="c8" value="候选 LUT：8 节点&#xa;等量分箱 → 加权中位数&#xa;isotonic 单调回归" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="anchorLane"><mxGeometry x="420" y="45" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="c12" value="候选 LUT：12 节点&#xa;等量分箱 → 加权中位数&#xa;isotonic 单调回归" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="anchorLane"><mxGeometry x="420" y="145" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="c16" value="候选 LUT：16 节点&#xa;等量分箱 → 加权中位数&#xa;isotonic 单调回归" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="anchorLane"><mxGeometry x="770" y="95" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="score" value="候选评分&#xa;全图锚帧 NMAE&#xa;+ face ROI NMAE（若有）&#xa;选择最小组合误差" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="anchorLane"><mxGeometry x="1130" y="75" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="canon" value="定长化&#xa;选中形状重采样为 16 节点&#xa;共享 anchor_lut_x / anchor_lut_y" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="anchorLane"><mxGeometry x="1450" y="80" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="afffb" value="支持不足？&#xa;回退鲁棒 affine&#xa;并编码为 16 节点 LUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="anchorLane"><mxGeometry x="1840" y="80" width="180" height="115" as="geometry"/></mxCell>

        <mxCell id="temporal" value="C. 从锚帧向前 / 向后传播全局参数" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="2050" height="270" as="geometry"/></mxCell>
        <mxCell id="premap" value="当前帧先应用共享 LUT&#xa;D_i → LUT(D_i)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="temporal"><mxGeometry x="70" y="80" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="corr" value="稀疏时序对应&#xa;MV 将当前样本映射至相邻已处理帧&#xa;越界与低 confidence 降权" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="temporal"><mxGeometry x="390" y="65" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="fit" value="只拟合小幅全局微调&#xa;candidate scale_i / offset_i&#xa;鲁棒 affine + fit confidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="temporal"><mxGeometry x="780" y="65" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="smooth" value="置信度加权平滑&#xa;逐帧限幅：scale ≤ ±1%&#xa;offset ≤ ±0.5% photo range" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="temporal"><mxGeometry x="1160" y="65" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="lock" value="锚点锁定与渐进解锁&#xa;锁定半径内复用锚帧 LUT&#xa;避免拍照时刻参数状态切换" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="temporal"><mxGeometry x="1540" y="65" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="insuff" value="时序支持不足&#xa;复用上一帧参数&#xa;记录 fallback reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="temporal"><mxGeometry x="1900" y="70" width="120" height="110" as="geometry"/></mxCell>

        <mxCell id="outLane" value="D. V4 播放与关键性质" style="swimlane;startSize=32;horizontal=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="920" width="2050" height="220" as="geometry"/></mxCell>
        <mxCell id="eq" value="每帧输出&#xa;B_i = scale_i · LUT(D_i) + offset_i&#xa;实现中 lut_y 已吸收该微调" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="outLane"><mxGeometry x="100" y="65" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="global" value="位置无关：同一 disparity 使用同一映射&#xa;默认 region_grid_shape=(0,0)&#xa;不生成 mask 边界、竖缝、“7”形分层或残差拖影" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="outLane"><mxGeometry x="570" y="55" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="cost" value="播放成本 / 像素&#xa;16 节点区间定位 + 1 次线性插值&#xa;+ 1 次全局 scale/offset&#xa;无 MV、无照片、无 warp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="outLane"><mxGeometry x="1120" y="55" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="limit" value="表达上限&#xa;只能按深度值全局映射&#xa;当人物 / 墙面同值但需要不同校正时无法同时满足&#xa;这正是 V5 引入局部场的原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="outLane"><mxGeometry x="1590" y="50" width="400" height="140" as="geometry"/></mxCell>

