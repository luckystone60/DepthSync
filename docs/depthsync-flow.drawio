<mxfile host="Electron" agent="Codex" version="24.7.17">
  <diagram id="depthsync-v4" name="DepthSync V4 端侧流程">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DepthSync V4：照片参数监督，视频结构与时域优先" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="无人物分割 mask｜无照片残差传播｜无可靠静态区域时自动回退到全局 LUT" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="62" width="1100" height="28" as="geometry"/></mxCell>

        <mxCell id="inputLane" value="A. 输入与统一工作域" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#E8F0FE;strokeColor=#5B8FF9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="1520" height="165" as="geometry"/></mxCell>
        <mxCell id="video" value="视频 disparity&#xa;T×Hv×Wv，FP16&#xa;验证：90 帧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="35" y="55" width="235" height="80" as="geometry"/></mxCell>
        <mxCell id="photo" value="照片 disparity&#xa;高质量锚帧 k&#xa;仅参数准备阶段使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="310" y="55" width="245" height="80" as="geometry"/></mxCell>
        <mxCell id="mv" value="block MV + confidence&#xa;T×GmH×GmW×2&#xa;编码器 / ISP 复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="595" y="55" width="255" height="80" as="geometry"/></mxCell>
        <mxCell id="face" value="可选人脸框&#xa;前景硬保护&#xa;不是人物分割 mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="890" y="55" width="245" height="80" as="geometry"/></mxCell>
        <mxCell id="unify" value="几何配准 + disparity 统一&#xa;照片 P10–P90 鲁棒范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="inputLane"><mxGeometry x="1175" y="50" width="300" height="90" as="geometry"/></mxCell>

        <mxCell id="prepareLane" value="B. 拍摄后参数准备" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#EAF7EA;strokeColor=#82B366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1520" height="265" as="geometry"/></mxCell>
        <mxCell id="sample" value="确定性采样&#xa;低梯度有效点&#xa;分位数 + MAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="prepareLane"><mxGeometry x="30" y="80" width="200" height="95" as="geometry"/></mxCell>
        <mxCell id="lut" value="共享 8 节点单调 LUT&#xa;锚帧固定非线性形状&#xa;逐帧仅小 affine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="prepareLane"><mxGeometry x="265" y="70" width="245" height="115" as="geometry"/></mxCell>
        <mxCell id="base" value="基础深度&#xa;Bi=scalei·LUT(Di)+offseti" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="prepareLane"><mxGeometry x="545" y="80" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="static" value="128×72 静态可靠性&#xa;MV + 时序 MAD + 全片极差&#xa;可选人脸前景保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="prepareLane"><mxGeometry x="800" y="65" width="265" height="125" as="geometry"/></mxCell>
        <mxCell id="segment" value="锚帧视频深度连通区域&#xa;四邻域阈值 4%&#xa;5×5 opening 清除细长分支&#xa;面积≥1%，静态支持≥65%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="prepareLane"><mxGeometry x="1100" y="55" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="offset" value="区域标量 offset&#xa;照片只提供区域中位目标&#xa;逐帧中位锁定 + 异常限幅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="prepareLane"><mxGeometry x="1390" y="65" width="105" height="130" as="geometry"/></mxCell>

        <mxCell id="rejectLane" value="C. 安全门：局部修正是可选增强" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FCE8E6;strokeColor=#B85450;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="1520" height="150" as="geometry"/></mxCell>
        <mxCell id="reject" value="面积小 / 运动 / 低置信 / 人脸相交 / 遮挡不确定 → 标签 0 → 仅全局 LUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;fontStyle=1;" vertex="1" parent="rejectLane"><mxGeometry x="100" y="55" width="650" height="65" as="geometry"/></mxCell>
        <mxCell id="noResidual" value="禁止：照片目标层、锚帧残差图、人物锚帧区域传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;" vertex="1" parent="rejectLane"><mxGeometry x="820" y="55" width="600" height="65" as="geometry"/></mxCell>

        <mxCell id="packageLane" value="D. 紧凑参数包" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E6;strokeColor=#D6B656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="1520" height="150" as="geometry"/></mxCell>
        <mxCell id="shared" value="共享：LUT 8×2 FP16&#xa;标签 72×128 U8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="packageLane"><mxGeometry x="120" y="55" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="perframe" value="逐帧：scale/offset&#xa;区域 offset≤9 + 全局 shift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="packageLane"><mxGeometry x="500" y="50" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="size" value="最坏约 11.4 KiB / 90 帧&#xa;无可靠区域约 0.8 KiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;fontStyle=1;" vertex="1" parent="packageLane"><mxGeometry x="950" y="50" width="430" height="75" as="geometry"/></mxCell>

        <mxCell id="runtimeLane" value="E. 播放阶段逐帧路径" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="1520" height="190" as="geometry"/></mxCell>
        <mxCell id="runtimeLut" value="① 8 节点 LUT&#xa;+ 小 affine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="runtimeLane"><mxGeometry x="55" y="65" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="warp" value="② 全局 shift&#xa;最近邻平移 U8 标签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="runtimeLane"><mxGeometry x="310" y="65" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="lookup" value="③ 标签查表&#xa;逐区域标量 offset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="runtimeLane"><mxGeometry x="595" y="65" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="guard" value="④ 完成到标签边界&#xa;不做尺度回退带" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="runtimeLane"><mxGeometry x="880" y="65" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="output" value="⑤ 同步深度 Yi&#xa;标签 0：严格全局路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="runtimeLane"><mxGeometry x="1160" y="60" width="280" height="90" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="sample" target="lut" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="lut" target="base" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="base" target="static" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="static" target="segment" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="segment" target="offset" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="runtimeLut" target="warp" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="warp" target="lookup" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="lookup" target="guard" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="guard" target="output" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
