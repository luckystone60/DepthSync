<mxfile host="Electron" agent="Codex" version="24.7.17">
  <diagram id="depthsync-v5" name="DepthSync V5 端侧流程">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DepthSync V5：光流引导的局部 affine 参数场" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="1140" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="照片深度只参与拍后准备｜播放不运行模型｜不传播照片残差｜低置信度逐像素回退 V4" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="inputLane" value="A. 输入与稳定基础" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#E8F0FE;strokeColor=#5B8FF9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="1520" height="160" as="geometry"/></mxCell>
        <mxCell id="rgb" value="RGB 视频&#xa;90 帧 / 30 fps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="40" y="55" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="videoDepth" value="轻量视频 disparity D_t&#xa;90×256×455" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="280" y="50" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="photoDepth" value="DepthPro 照片 disparity P_k&#xa;1080×1920 / 锚帧 k=45" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="550" y="50" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="geometry" value="几何配准 + disparity 统一&#xa;照片降采样到视频深度尺寸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="inputLane"><mxGeometry x="860" y="50" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="v4" value="V4 全局单调 LUT&#xa;输出稳定基础深度 B_t&#xa;始终保留为安全回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" vertex="1" parent="inputLane"><mxGeometry x="1170" y="45" width="290" height="90" as="geometry"/></mxCell>

        <mxCell id="prepareLane" value="B. 拍摄完成后的准备阶段（目标 1–2 秒）" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#EAF7EA;strokeColor=#82B366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="1520" height="270" as="geometry"/></mxCell>
        <mxCell id="flowModel" value="SEA-RAFT-S / 可替换小模型&#xa;144×256 相邻帧双向 flow&#xa;仅准备阶段运行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="prepareLane"><mxGeometry x="35" y="60" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="reliability" value="连续可靠度&#xa;模型不确定度 × FB consistency&#xa;× 越界 × 光度/梯度 × 切镜" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="prepareLane"><mxGeometry x="335" y="55" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="anchorFit" value="锚帧 36×64 局部 affine 拟合&#xa;重叠窗口 + robust IRLS&#xa;仅此处做一次空间平滑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="prepareLane"><mxGeometry x="660" y="55" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="transport" value="从 k 向前/后纯传输参数&#xa;可信轨迹不重复正则、不累计衰减&#xa;遮挡/新显露区 smoothstep→identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;" vertex="1" parent="prepareLane"><mxGeometry x="985" y="50" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="fallback" value="异常？&#xa;整段 V4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="prepareLane"><mxGeometry x="1340" y="65" width="125" height="90" as="geometry"/></mxCell>
        <mxCell id="prepareNote" value="禁止路径：传播照片残差图 / 传播人物 mask / 每帧重新拟合或平滑局部参数" style="text;html=1;strokeColor=#B85450;fillColor=#FCE8E6;rounded=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#B85450;" vertex="1" parent="prepareLane"><mxGeometry x="330" y="195" width="860" height="42" as="geometry"/></mxCell>

        <mxCell id="packageLane" value="C. 序列化播放参数" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FFF8E6;strokeColor=#D6B656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="1520" height="150" as="geometry"/></mxCell>
        <mxCell id="v4Pack" value="V4 参数&#xa;16 节点 LUT + 逐帧标量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="packageLane"><mxGeometry x="155" y="52" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="localPack" value="逐帧 36×64×3 FP16&#xa;δscale / offset_norm / confidence&#xa;90 帧共 1,244,160 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="packageLane"><mxGeometry x="515" y="45" width="350" height="85" as="geometry"/></mxCell>
        <mxCell id="notPacked" value="不下发：照片深度、dense flow、残差图&#xa;depth_low 可由当前 B_t 36×64 降采样得到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;dashed=1;" vertex="1" parent="packageLane"><mxGeometry x="955" y="45" width="400" height="85" as="geometry"/></mxCell>

        <mxCell id="runtimeLane" value="D. Live Photo 播放阶段（逐帧）" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="1520" height="220" as="geometry"/></mxCell>
        <mxCell id="runtimeInput" value="视频 disparity D_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="runtimeLane"><mxGeometry x="35" y="75" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="runtimeV4" value="V4 LUT → B_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" vertex="1" parent="runtimeLane"><mxGeometry x="270" y="75" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="runtimeField" value="读取当前帧 36×64 参数&#xa;约 13.5 KiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="runtimeLane"><mxGeometry x="505" y="68" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="guided" value="深度引导 2×2 上采样&#xa;bilinear × bilateral depth weight&#xa;参数不跨深度边缘混合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="runtimeLane"><mxGeometry x="780" y="60" width="285" height="95" as="geometry"/></mxCell>
        <mxCell id="blend" value="Y_t = B_t + c·(δa·B_t + b·range)&#xa;c=0 时逐像素严格等于 V4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;" vertex="1" parent="runtimeLane"><mxGeometry x="1110" y="62" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="runtimeNote" value="播放阶段：无模型推理｜无 dense flow｜无照片深度｜无人物分割 mask" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontColor=#666666;" vertex="1" parent="runtimeLane"><mxGeometry x="460" y="165" width="650" height="25" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="rgb" target="flowModel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="photoDepth" target="geometry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="videoDepth" target="v4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="geometry" target="anchorFit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="v4" target="anchorFit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="flowModel" target="reliability" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="reliability" target="transport" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="anchorFit" target="transport" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="transport" target="fallback" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="transport" target="localPack" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="v4" target="v4Pack" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="runtimeInput" target="runtimeV4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" edge="1" parent="1" source="runtimeV4" target="guided" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" edge="1" parent="1" source="runtimeField" target="guided" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" edge="1" parent="1" source="guided" target="blend" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
