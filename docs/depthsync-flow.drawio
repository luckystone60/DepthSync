<mxfile host="drawio" modified="2026-08-05T15:20:00.000Z" agent="Codex" version="30.3.13" pages="5">
  <diagram id="overview" name="01 总览与时序">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="DepthSync V4 / V5 总览：Live Photo 深度对齐的离线准备与轻量播放" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="目标：照片锚帧统一尺度与局部质量；视频深度保留时域稳定性；所有不可靠局部校正连续回退 V4" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="65" width="1600" height="30" as="geometry"/></mxCell>

        <mxCell id="capture" value="采集与模型输入" style="swimlane;startSize=32;horizontal=0;rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="2050" height="210" as="geometry"/></mxCell>
        <mxCell id="video" value="Live Photo 视频&#xa;T=90，30 fps，约 3 s&#xa;照片时刻 k≈45" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="capture"><mxGeometry x="70" y="55" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="vda" value="Video Depth Anything Small&#xa;stream 模式&#xa;D_t：[T,Hv,Wv] disparity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="capture"><mxGeometry x="380" y="55" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="photo" value="Live Photo 照片&#xa;与视频锚帧对齐&#xa;高分辨率 RGB" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="capture"><mxGeometry x="720" y="55" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="anchor" value="单帧高质量深度&#xa;产品：重模型输出&#xa;离线仿真：DAv2-Large（原 DepthPro）&#xa;P_k：[Hp,Wp] disparity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="capture"><mxGeometry x="1030" y="45" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="rgb" value="RGB 帧序列&#xa;V5 光流输入&#xa;缩放至 144×256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="capture"><mxGeometry x="1420" y="55" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="motion" value="V4：编码器/ISP block MV（可选）&#xa;V5：SEA-RAFT-S 双向 dense flow（必需）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="capture"><mxGeometry x="1730" y="55" width="270" height="100" as="geometry"/></mxCell>

        <mxCell id="prepare" value="拍摄完成后的参数准备阶段（目标预算 1–2 s）" style="swimlane;startSize=32;horizontal=0;rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="2050" height="280" as="geometry"/></mxCell>
        <mxCell id="norm" value="坐标/方向统一&#xa;depth→disparity&#xa;照片配准到视频深度坐标" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="prepare"><mxGeometry x="70" y="75" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="v4prep" value="V4 全局稳定基线&#xa;锚帧自适应 8/12/16 节点单调 LUT&#xa;MV 约束逐帧微小 scale/offset&#xa;得到 B_0…B_89" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="prepare"><mxGeometry x="410" y="55" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="v5decision" value="启用 V5 且&#xa;RGB / flow 有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="prepare"><mxGeometry x="850" y="65" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="flowprep" value="SEA-RAFT-S&#xa;89 对相邻帧双向光流&#xa;FB/越界/外观/切镜置信度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="prepare"><mxGeometry x="1140" y="45" width="290" height="160" as="geometry"/></mxCell>
        <mxCell id="localprep" value="V5 局部 affine 场&#xa;锚帧 36×64 robust fit&#xa;沿可靠光流向前/向后纯传输&#xa;遮挡/新显露区域回到 identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="prepare"><mxGeometry x="1530" y="45" width="350" height="160" as="geometry"/></mxCell>
        <mxCell id="v4fallback" value="V4 参数包&#xa;安全基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="prepare"><mxGeometry x="1900" y="75" width="120" height="100" as="geometry"/></mxCell>

        <mxCell id="package" value="持久化参数（模型和中间 flow 均不进入播放包）" style="swimlane;startSize=32;horizontal=0;rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="670" width="2050" height="150" as="geometry"/></mxCell>
        <mxCell id="v4pack" value="V4：共享 16 节点 LUT + 90 帧 scale/offset&#xa;推荐约 0.5–0.6 KiB / Live Photo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="package"><mxGeometry x="180" y="50" width="450" height="70" as="geometry"/></mxCell>
        <mxCell id="v5pack" value="V5：Δscale / offset_norm / confidence&#xa;90×36×64×3×FP16 = 1,244,160 B（约 1.19 MiB）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="package"><mxGeometry x="820" y="50" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="notpack" value="不保存：照片残差图、人物 mask、dense flow、光流模型运行态&#xa;depth_low 可由当前 B_t 降采样，不计入产品参数包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="package"><mxGeometry x="1520" y="45" width="450" height="80" as="geometry"/></mxCell>

        <mxCell id="runtime" value="播放阶段（逐帧，无照片深度、无光流模型）" style="swimlane;startSize=32;horizontal=0;rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="850" width="2050" height="250" as="geometry"/></mxCell>
        <mxCell id="rtin" value="当前视频深度 D_t" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="runtime"><mxGeometry x="90" y="85" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="rtv4" value="V4 LUT + 帧级标量&#xa;B_t" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="runtime"><mxGeometry x="390" y="75" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="rtv5d" value="该帧 V5 局部场有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="runtime"><mxGeometry x="740" y="65" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="rtup" value="2×2 网格 gather&#xa;+ V4 深度引导 bilateral 上采样&#xa;+ confidence blend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="runtime"><mxGeometry x="1060" y="65" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="rtout" value="同步深度 Y_t&#xa;用于 Live Photo 人像虚化" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="runtime"><mxGeometry x="1510" y="65" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="identity" value="c=0 / V5 禁用&#xa;Y_t ≡ B_t（逐像素严格回退）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="runtime"><mxGeometry x="1840" y="70" width="180" height="100" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="video" target="vda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
